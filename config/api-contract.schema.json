{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chronicle-memory-v2/api-contract.schema.json",
  "description": "Local JSON Schema transcription of the public Cycle 2 Textual Add/Search contract; the official API Guide remains authoritative.",
  "$defs": {
    "AddRequest": {
      "type": "object",
      "required": ["request_id", "messages", "user_id", "session_id"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["user", "assistant"]},
              "content": {"type": "string", "minLength": 1},
              "timestamp": {"type": "integer", "description": "Unix milliseconds when supplied by the source"}
            }
          }
        },
        "user_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "AddResponse": {
      "type": "object",
      "required": ["success", "request_id", "user_id", "session_id"],
      "properties": {
        "success": {"const": true},
        "request_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "SearchRequest": {
      "type": "object",
      "required": ["query", "user_id", "top_k"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"type": "string"}},
        "user_id": {"type": "string", "minLength": 1},
        "top_k": {"type": "integer", "minimum": 1}
      }
    },
    "SearchResponse": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "content": {"type": "string", "minLength": 1},
              "score": {"type": "number"},
              "created_at": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
